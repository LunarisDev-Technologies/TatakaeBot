# Tatakae Nexus Environment Configuration Example
NODE_ENV=development

# Discord Bot & Application Credentials
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_GUILD_ID=your_primary_guild_id_here
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback/discord

# Database (Local MongoDB)
DATABASE_URL=mongodb://localhost:27017/tatakae_nexus
MONGODB_URI=mongodb://localhost:27017/tatakae_nexus

# Redis & Queues
# When running locally without docker network use localhost:6379. In docker-compose use redis:6379.
REDIS_URL=redis://localhost:6379

# Applications & Services
API_PORT=4000
API_URL=http://localhost:4000
DASHBOARD_PORT=3000
DASHBOARD_URL=http://localhost:3000

# Security & Sessions
SESSION_SECRET=tatakae_nexus_session_secret_32_characters_min
ENCRYPTION_KEY=tatakae_nexus_encryption_32_bytes_key_00

# Regional & Logging
DEFAULT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

